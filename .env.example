# Copy this file to .env.local and fill in the values.

# Telegram bot token from @BotFather (e.g. 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Chat ID(s) that should receive form submissions (user, group or channel ID).
# Groups/channels usually start with -100... Use commas for several: 123456789,-1001234567890
TELEGRAM_CHAT_ID=

# Public URL of the deployed site (used for SEO, sitemap and Open Graph tags).
NEXT_PUBLIC_SITE_URL=https://fidinda-management.vercel.app
